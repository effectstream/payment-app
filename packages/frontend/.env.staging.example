# Copy this to `packages/frontend/.env.staging` and fill in real values.
# These are FRONTEND Vite vars. They are bundled into the browser build —
# do NOT put secrets here. Backend/deploy secrets live in the repo-root
# `.env.staging`.

# Where the sync node's HTTP API is reachable from the browser.
VITE_EFFECTSTREAM_NODE_URL=http://localhost:9999

# Where the batcher's /send-input endpoint lives.
VITE_BATCHER_URL=http://localhost:3334

# Chain ID the frontend / connected wallet should be on.
# 11155111 = Sepolia, 31337 = Hardhat (dev), 421614 = Arbitrum Sepolia.
VITE_CHAIN_ID=11155111

# Deployed contract address on the target chain. Must match
# EFFECTSTREAM_L2_ADDRESS in the repo-root .env.staging.
VITE_EFFECTSTREAM_L2_ADDRESS=

# Frontend RPC URL for read-only chain queries (the payment picker's
# wallet-balance check, primarily). Distinct from the backend EVM_RPC_URL
# secret — this one ships to the browser. Point at an Alchemy/Infura URL
# with origin restrictions configured in the provider dashboard, or leave
# unset to fall back to https://ethereum-sepolia-rpc.publicnode.com.
#
# Why this matters: MetaMask's bundled Sepolia RPC (shared Infura) gets
# globally rate-limited and returns -32002 errors. If you leave this unset
# and the public node also gets squeezed, the picker shows "Couldn't read
# wallet balance" until it recovers. A paid RPC here makes the picker
# reliable.
# VITE_EVM_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Enable the Transak fiat / card payment option in the checkout picker.
# All Transak config (apiKey, apiSecret, contractId, network, environment)
# lives in the repo-root .env.staging — the browser only needs to know
# whether to call the backend /api/transak/widget-url session endpoint.
VITE_TRANSAK_ENABLED=true

# Staging-only demo flag. Transak's STAGING environment does not settle on
# Sepolia, so after a test-card purchase the sync node never sees an
# on-chain event and the demo flow stalls on "polling inventory…".
# When this flag is true and a wallet is connected, the frontend listens
# for Transak's TRANSAK_ORDER_SUCCESSFUL event and fires a real Sepolia
# transaction from the connected wallet so the audience can see the full
# Transak UI → on-chain → sync → inventory-update pipe end-to-end.
# MUST stay unset / false in production — there the real Transak settlement
# is on-chain and any extra wallet tx would double-charge the user.
VITE_TRANSAK_DEMO_FALLBACK=true
